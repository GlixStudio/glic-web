{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "encoder-glix",
  "compatibility_date": "2025-04-03",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "encoder.glix.studio",
      "custom_domain": true
    }
  ]
}
